# --- required ---
UPI_ID=yourshop@okhdfcbank
UPI_NAME=Your Shop

# --- the inbox that receives your bank's credit alerts (see README: "Gmail setup") ---
GMAIL_ADDRESS=youralerts@gmail.com
# Google Account -> Security -> 2-Step Verification -> App passwords. Never use your normal password.
GMAIL_APP_PASSWORD=

# --- recommended ---
# Postgres / Supabase / Neon connection string. Without it payments are kept in memory (lost on restart).
DATABASE_URL=
# DATABASE_SSL=1
# Your backend sends this (Authorization: Bearer ...) to create payments and read the admin routes.
UPI_API_KEY=
# Where to POST payment.paid / payment.underpaid, and the secret that signs them.
WEBHOOK_URL=
WEBHOOK_SECRET=
# Websites allowed to use the checkout widget (comma-separated), or *
ALLOWED_ORIGINS=

# --- optional ---
# UPI_PUBLIC_CREATE=1        let the widget create payments itself (simple sites without a backend)
# UPI_TEST_MODE=1            no real money: demo page at / and a "simulate payment" button
# UPI_EXPIRES_MINUTES=10
# UPI_REF_PREFIX=PAY
# UPI_ALERT_SENDERS=alerts@hdfcbank.net   only trust your bank's alert address
# UPI_SYNC_SECONDS=15
# PORT=8787
